# For use with https://elements.heroku.com/buildpacks/gjaldon/heroku-buildpack-phoenix-static

source $phoenix_dir/load_env.sh

echo "---- Building UI, running: npm run build"

cd $phoenix_dir/ui
npm run build

echo "---- UI build done, running: mix assets.deploy"

cd $phoenix_dir
mix assets.deploy

echo "---- mix assets.deploy done"
echo "---- Building release, running: mix release"

# Last, so the release carries the digested assets built above. One-off dynos can
# still use Mix; web and the release phase start from this.
MIX_ENV=prod mix release --overwrite

echo "---- mix release done"
