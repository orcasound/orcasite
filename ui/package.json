{
  "name": "orcasite",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${UI_PORT:-3000}",
    "build": "next build",
    "build:dev": "dotenv -c development npm run build",
    "start": "next start -p ${UI_PORT:-3000}",
    "start:dev": "dotenv -c development npm run start",
    "lint": "eslint src test",
    "lint:fix": "eslint --fix src test",
    "format": "prettier . --write",
    "codegen": "graphql-codegen",
    "analyze": "ANALYZE=true next build --webpack",
    "prepare": "cd .. && husky ui/.husky",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run lint"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/noto-mono": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv-cli": "^11.0.0",
    "graphql": "^16.14.2",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "lodash": "^4.18.1",
    "next": "16.3.6",
    "phoenix": "^1.8.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-fast-marquee": "^1.6.5",
    "react-ga4": "^3.0.1",
    "react-leaflet": "^5.0.0",
    "react-vega": "^8.0.0",
    "sharp": "^0.35.5",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.4.3",
    "video.js": "^8.24.1",
    "videojs-offset": "^2.1.3"
  },
  "devDependencies": {
    "@graphql-codegen/add": "^7.1.1",
    "@graphql-codegen/cli": "7.4.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.8",
    "@graphql-codegen/typescript-react-query": "^7.0.5",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@next/bundle-analyzer": "^16.3.6",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/lodash": "^4.17.25",
    "@types/node": "24.19.0",
    "@types/phoenix": "^1.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
