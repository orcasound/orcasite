# Inlining these is safe locally, where the app is built and run in one
# environment. Deployed builds must not set NEXT_PUBLIC_* at all -- see
# .env.production and src/utils/runtimeConfig.ts.
NEXT_PUBLIC_GQL_ENDPOINT='http://localhost:${SERVER_PORT:-4000}/graphql'
NEXT_PUBLIC_SOCKET_ENDPOINT='ws://localhost:${SERVER_PORT:-4000}/socket'
NEXT_PUBLIC_S3_BUCKET='dev-streaming-orcasound-net'

# `next dev` sets NODE_ENV=development and needs no flag. `npm run build:dev` /
# `start:dev` build with NODE_ENV=production while still serving Next on :3000
# against Phoenix on :4000, so they opt in explicitly to use the values above.
NEXT_PUBLIC_ALLOW_INLINED_CONFIG=true